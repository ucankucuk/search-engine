# Copy this file to .env and fill in your own mock provider URLs.
# Within the Docker Compose network, services reach each other by
# container name, so we write the Mongo/Elasticsearch URLs using the
# service name (mongo, elasticsearch) rather than "localhost" — see
# docker-compose.yml.

HTTP_PORT=8080
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=search_engine
ELASTIC_URL=http://elasticsearch:9200

# PROVIDER_A_URL: the REAL JSON provider (a static mock file, reachable
# over the internet).
PROVIDER_A_URL=https://raw.githubusercontent.com/WEG-Technology/mock/refs/heads/main/v2/provider1

# PROVIDER_B_URL: our own designed/run JSON provider — the
# json-provider-a service in docker-compose.yml, by container name:
PROVIDER_B_URL=http://json-provider-a:4001/json-a

# PROVIDER_XML_URL: the REAL XML provider (a static mock file, reachable
# over the internet).
PROVIDER_XML_URL=https://raw.githubusercontent.com/WEG-Technology/mock/refs/heads/main/v2/provider2

# RATE_LIMIT_RPS/RATE_LIMIT_BURST: the per-IP rate limit for /search and
# /refresh (see internal/transport/http/middleware/ratelimit.go).
# The defaults (RPS=5, Burst=10) are already defined in code — add these
# here ONLY if you want to try a different value.
# RATE_LIMIT_RPS=5
# RATE_LIMIT_BURST=10
